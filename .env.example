# ── App ──────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000          # prod: dominio público. En previews de Vercel puede quedar vacío (usa VERCEL_URL)

# ── Auth (jose) ─────────────────────────────────────
AUTH_SECRET=change-me-min-32-chars-change-me-min-32-chars   # openssl rand -base64 48
MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_DAYS=7
ADMIN_EMAILS=admin@demo.local          # emails que reciben rol admin al crearse (separados por coma)
AUTH_RATE_LIMIT_MAX=5                  # solicitudes de magic link por email cada 15 min (E2E: súbelo)

# ── MongoDB ─────────────────────────────────────────
# Local: docker (replica set). Prod: Atlas mongodb+srv://...
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=bonds
# Si el puerto 27017 del host está ocupado (p. ej. mongod de Homebrew), define MONGO_PORT=27018 en `.env`
# (lo lee docker compose) y ajusta el puerto en MONGODB_URI.

# ── Mailer ──────────────────────────────────────────
MAIL_DRIVER=smtp                       # smtp (MailHog) | resend | memory (solo CI)
MAIL_FROM="Bonos <no-reply@localhost>"
SMTP_HOST=localhost
SMTP_PORT=1025
MAILHOG_API_URL=http://localhost:8025  # solo E2E
RESEND_API_KEY=

# ── Storage (RustFS local / Cloudflare R2 prod) ────
STORAGE_DRIVER=s3                      # s3 | fs (solo CI)
STORAGE_FS_DIR=.tmp/storage            # solo con STORAGE_DRIVER=fs
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1                    # R2: auto
S3_BUCKET=bonds-docs
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_TTL_SECONDS=300

# ── Jobs / Cron ─────────────────────────────────────
CRON_SECRET=change-me                  # openssl rand -hex 32

# ── Alertas (defaults) ──────────────────────────────
ALERT_PRICE_MOVE_BPS=200
ALERT_CONCENTRATION_PCT=30

# ── Seeds ───────────────────────────────────────────
SEED_PROFILE=dev                       # dev | e2e | demo
ALLOW_SEED=false                       # requerido en producción
SEED_DEMO_INVESTORS=                   # solo perfil demo: emails de inversores separados por coma (máx. 10)
# Producción: guarda las credenciales reales en `.env.production.local` (no versionado) y sigue AGENTS.md §11.

# ── E2E ─────────────────────────────────────────────
BASE_URL=http://localhost:3000
E2E_MODE=false                         # true habilita /api/test/* (nunca en prod)
E2E_MAILBOX=mailhog                    # mailhog (local) | memory (CI)
E2E_MONGO=external                     # external (docker/Atlas) | memory (mongodb-memory-server en CI)
